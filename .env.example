# Copie para .env e ajuste.

# Usuário e senha de acesso ao sistema
GILDA_USER=gilda
GILDA_PASSWORD=gilda123

# Chave para assinar o cookie de sessão (troque por qualquer texto longo e aleatório)
GILDA_SECRET_KEY=troque-esta-chave-por-uma-longa-e-aleatoria

# 1 = cria peças e insumos de exemplo na primeira execução (banco vazio); 0 = começa vazio
GILDA_SEED_EXEMPLO=1

# Porta exposta no computador (o sistema abre em http://localhost:PORTA)
GILDA_PORT=11111
